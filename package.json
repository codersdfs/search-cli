{
  "name": "github-search-cli",
  "version": "9.7.0",
  "description": "Search GitHub from your terminal — repo search, trending repos, npm package search, bookmarks, deep-dive, compare, export. Keyboard-driven TUI + pipeable CLI.",
  "type": "module",
  "packageManager": "bun@1",
  "volta": {
    "extensions": [
      ".ts"
    ]
  },
  "bin": {
    "ghfind": "bin/ghfind.js"
  },
  "bun": {
    "smol": true
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "scripts/",
    "completions/",
    "demo.svg",
    "LICENSE",
    "CHANGELOG.md",
    "release-notes/",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "dev": "bun run --watch src/tui.ts",
    "postinstall": "node scripts/postinstall.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome@2.5.13 check .",
    "check": "prettier --check . && bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codersdfs/search-cli.git"
  },
  "bugs": {
    "url": "https://github.com/codersdfs/search-cli/issues"
  },
  "homepage": "https://github.com/codersdfs/search-cli#readme",
  "keywords": [
    "github",
    "github-search",
    "github-api",
    "cli",
    "cli-tool",
    "search",
    "trending",
    "trending-repositories",
    "terminal",
    "tui",
    "commandline",
    "developer-tools",
    "developer-experience",
    "npm-search",
    "octokit",
    "gh",
    "opentui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
